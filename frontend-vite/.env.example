# frontend-vite/.env.example — copy to frontend-vite/.env and fill in. Never commit .env.
# Every VITE_ value ends up in the browser bundle, so none of these are secrets,
# but use the dev/test Firebase project locally, not prod.

# Leave empty in dev: vite.config.js proxies /api to http://localhost:5000.
VITE_API_BASE_URL=

# Firebase web config (customer + agent login). The build and tests need these
# to be present; dummy values work for tests (see .github/workflows/ci-cd.yml).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Maps on property pages and the listing form
VITE_GOOGLE_MAPS_API_KEY=

# Feature flag: shows "My listings" / posting for customers and agents.
# Keep in step with the backend's ENABLE_CUSTOMER_LISTINGS.
VITE_ENABLE_CUSTOMER_LISTINGS=false
