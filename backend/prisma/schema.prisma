generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadType {
  customer
  developer
  broker
  builder
}

enum LeadStage {
  new
  contacted
  qualified
  converted
  rejected
}

enum CrmRole {
  admin
  sales_manager
  sales_rep
}

model CrmUser {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      CrmRole
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  leads      Lead[]
  activities LeadActivity[]
  siteVisits SiteVisit[]

  @@map("crm_users")
}

model Lead {
  id             String    @id @default(uuid())
  leadType       LeadType  @map("lead_type")
  name           String
  email          String
  phone          String
  source         String
  propertyId     String?   @map("property_id")   // Mongo ObjectId as text — not a real FK, properties live in a different DB
  propertyTitle  String?   @map("property_title")
  contactConsent Boolean   @default(true) @map("contact_consent")
  stage          LeadStage @default(new)
  assignedTo     String?   @map("assigned_to")
  assignee       CrmUser?  @relation(fields: [assignedTo], references: [id])
  metadata       Json      @default("{}")
  pageUrl        String?   @map("page_url")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  activities LeadActivity[]
  siteVisits SiteVisit[]

  @@index([email])
  @@index([phone])
  @@index([createdAt])
  @@index([source])
  @@index([assignedTo])
  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(uuid())
  leadId       String   @map("lead_id")
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  crmUserId    String   @map("crm_user_id")
  crmUser      CrmUser  @relation(fields: [crmUserId], references: [id])
  activityType String   @map("activity_type")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("lead_activities")
}

model SiteVisit {
  id          String   @id @default(uuid())
  leadId      String   @map("lead_id")
  lead        Lead     @relation(fields: [leadId], references: [id])
  crmUserId   String   @map("crm_user_id")
  crmUser     CrmUser  @relation(fields: [crmUserId], references: [id])
  scheduledAt DateTime @map("scheduled_at")
  status      String   @default("scheduled")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("site_visits")
}
