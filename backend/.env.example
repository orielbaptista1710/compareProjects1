# backend/.env.example — copy to backend/.env and fill in. Never commit .env.
# config/env.js validates these at startup (utils/validateEnv.js) and refuses to
# boot on a bad config. Ask the project owner for dev values; never use prod ones
# on your machine.

# ── Required ──────────────────────────────────────────────
MONGO_URI=                    # MongoDB "comparedb" (use a dev database, not prod)
DATABASE_URL=                 # Postgres for leads/CRM (Prisma)
JWT_SECRET=                   # developer/admin login tokens; at least 32 characters

# ── Server ────────────────────────────────────────────────
NODE_ENV=development          # development | production (test is set by vitest only)
PORT=5000
REACT_APP_FRONTEND_URL=http://localhost:5173   # comma-separated allowed origins (CORS + Origin check)

# ── Customer auth (Firebase Admin) ────────────────────────
# Service-account JSON on one line. Required in production. Locally you can
# instead put the key file at backend/config/firebase-service-account.json (gitignored).
FIREBASE_SERVICE_ACCOUNT=

# ── Feature flags ─────────────────────────────────────────
ENABLE_CUSTOMER_LISTINGS=false   # true mounts /api/customers/listings (owner/agent posting)

# ── Media (Cloudinary) ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Optional ──────────────────────────────────────────────
NEWS_API_KEY=                 # GNews, for /api/news
APP_NAME=CompareProjects      # User-Agent for the geocoding provider
CONTACT_EMAIL=                # User-Agent contact for the geocoding provider
